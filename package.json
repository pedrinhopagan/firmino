{
  "name": "firmino",
  "version": "0.1.0",
  "private": true,
  "description": "Secretário pessoal que fica aberto no seu computador",
  "author": "Pedro Antônio Pagan Bonaldo",
  "desktopName": "firmino.desktop",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "out/main/index.js",
  "trustedDependencies": ["electron"],
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "bun run build:engine && electron-vite dev",
    "build:engine": "bun build --compile --no-compile-autoload-dotenv --outfile dist-engine/firmino-engine src/engine/index.ts src/engine/whatsapp/whatsapp-connection.ts",
    "build:electron": "electron-vite build",
    "build": "bun run build:engine && bun run build:electron",
    "package:linux": "bun run build && electron-builder --linux",
    "install:linux": "bun run package:linux && sh scripts/install-linux.sh",
    "bench:boot": "bun bench/boot.ts",
    "bench:memory": "bun bench/memory.ts",
    "typecheck": "tsc --noEmit",
    "check": "juicerq-check",
    "check:fix": "juicerq-check --fix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-store": "0.11.1",
    "baileys": "7.0.0-rc14",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "10.7.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-gfm": "3.0.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@juicerq/check": "^0.4.0",
    "@tailwindcss/vite": "^4",
    "@types/bun": "1.4.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
