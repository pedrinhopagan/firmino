{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "vite/client"],
    "allowImportingTsExtensions": false,
    "paths": {
      "@src/*": ["./src/*"]
    }
  },
  "include": ["src", "bench", "electron.vite.config.ts"]
}
